# 复制为 .env 并填写。仅支持 Anthropic Messages 协议，不支持仅提供 Chat Completions 的地址。
# 密钥只保存在本地，不要贴入聊天或提交到版本库。
ANTHROPIC_API_KEY=
# 填写你的服务商实际支持的 Claude 模型 ID，不在代码中绑定特定版本。
ANTHROPIC_MODEL=

# 基础地址自动补 /v1/messages；以 /v1 结尾只补 /messages。
ANTHROPIC_BASE_URL=https://api.anthropic.com
# 也可直接填完整 HTTPS 接口地址。非空时优先于 BASE_URL，不再补路径。
ANTHROPIC_API_URL=
ANTHROPIC_VERSION=2023-06-01

ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TIMEOUT_SECONDS=120
# 每个任务最多尝试多少次模型调用；请求失败和取消不会被报告为任务完成。
HARNESS_MAX_TURNS=8
